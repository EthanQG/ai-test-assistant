# DeepSeek-compatible chat completion API
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Generation parameters
MAX_TOKENS=4096
TEMPERATURE=0.7
REQUEST_TIMEOUT=120

# Local knowledge file
KNOWLEDGE_BASE_PATH=./knowledge/bug_experience.txt

# Task persistence (memory remains the safe local default)
TASK_REPOSITORY_BACKEND=memory
# Confirmed KnowledgeAsset persistence (keep memory until MySQL is intended)
KNOWLEDGE_ASSET_REPOSITORY_BACKEND=memory
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_test_assistant
MYSQL_CONNECT_TIMEOUT=10

# KnowledgeAsset V2 vector indexing (used only by the explicit indexing service)
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT=60
MILVUS_URI=http://127.0.0.1:19530
MILVUS_ASSET_COLLECTION=knowledge_assets_v2
MILVUS_TOKEN=
