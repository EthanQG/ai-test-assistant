# DeepSeek-compatible chat completion API
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
RUN_REVIEWER_INTEGRATION_EVALUATION=0
RUN_REVISER_INTEGRATION_EVALUATION=0
RUN_THREE_WAY_INTEGRATION_EVALUATION=0
THREE_WAY_EVALUATION_CASE_LIMIT=1

# Generation parameters
MAX_TOKENS=4096
TEMPERATURE=0.7
REQUEST_TIMEOUT=120

# Local knowledge file
KNOWLEDGE_BASE_PATH=./knowledge/bug_experience.txt

# Task persistence (memory remains the safe local default)
TASK_REPOSITORY_BACKEND=memory
# Confirmed KnowledgeAsset persistence (keep memory until MySQL is intended)
KNOWLEDGE_ASSET_REPOSITORY_BACKEND=memory
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_test_assistant
MYSQL_CONNECT_TIMEOUT=10

# KnowledgeAsset V2 vector indexing (used only by the explicit indexing service)
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT=60
MILVUS_URI=http://127.0.0.1:19530
MILVUS_ASSET_COLLECTION=knowledge_assets_v2
MILVUS_TOKEN=
RUN_RAG_INTEGRATION_EVALUATION=0
KNOWLEDGE_RETRIEVAL_TOP_K=3
KNOWLEDGE_RETRIEVAL_RAW_LIMIT=20
KNOWLEDGE_RETRIEVAL_MIN_SCORE=0.65

# Optional local OCR runtime. Install Tesseract and the chi_sim/eng language data.
# When unavailable, document parsing continues and records an OCR warning.
TESSERACT_CMD=tesseract
OCR_LANGUAGES=chi_sim+eng
OCR_TIMEOUT_SECONDS=30

# Optional OpenAI-compatible multimodal endpoint. Images are only sent when
# deterministic document context marks them as a flow/state/sequence/UI candidate.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=60
VISION_MAX_TOKENS=1500
